    -- ── Lookup de emoji ──────────────────────────────
    local function getMutEmoji(name)
        if not name then return nil end
        local key = TRAIT_ALIAS[name] or name  -- normaliza "Yin Yang" → "YinYang"
        if WEBHOOK_MUTATION_EMOJIS[key] then return WEBHOOK_MUTATION_EMOJIS[key] end
        -- tenta case-insensitive
        local kl = key:lower()
        for k,v in pairs(WEBHOOK_MUTATION_EMOJIS) do
            if k:lower()==kl then return v end
        end
        -- fallback: tenta nos trait emojis (ex: Disco)
        if WEBHOOK_TRAIT_EMOJIS[key] then return WEBHOOK_TRAIT_EMOJIS[key] end
        return name  -- nome puro se não achar emoji
    end

    local function getTraitEmoji(name)
        local key = TRAIT_ALIAS[name] or name
        if WEBHOOK_TRAIT_EMOJIS[key] then return WEBHOOK_TRAIT_EMOJIS[key] end
        local kl = key:lower()
        for k,v in pairs(WEBHOOK_TRAIT_EMOJIS) do
            if k:lower()==kl then return v end
        end
        return name  -- fallback nome
    end

    -- ── Localizar plot rival ─────────────────────────
    local function findRivalPlot()
        local p3 = Vector3.new(-476.752,10.464,7.107)
        local p7 = Vector3.new(-476.752,10.464,114.107)
        for _,v in ipairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") and v.Name=="PlotSign" then
                local d3=(v.Position-p3).Magnitude
                local d7=(v.Position-p7).Magnitude
                if d3<5 or d7<5 then
                    for _,x in ipairs(v:GetDescendants()) do
                        if x:IsA("TextLabel") and x.Text~="" then
                            if x.Text:find(LP.Name,1,true) or x.Text:find(LP.DisplayName,1,true) then
                                return (d3<5) and p7 or p3
                            end
                        end
                    end
                end
            end
        end
        return nil
    end

    -- ── Analisar SurfaceGui do brainrot ──────────────
    local function analyzeSurfaceGui(sg)
        local out = {name=nil,rarity=nil,mutation=nil,traits={}}
        local textParts,nameParts = {},{}
        for _,d in ipairs(sg:GetDescendants()) do
            nameParts[#nameParts+1]=d.Name
            if d:IsA("TextLabel") or d:IsA("TextButton") then
                local t=stripTags(d.Text)
                if t and t:gsub("%s","")~="" then
                    textParts[#textParts+1]=t
                    local n=d.Name
                    if n=="DisplayName" then out.name=t
                    elseif n=="Rarity" then out.rarity=t
                    elseif n=="Mutation" or n=="Mutations" then out.mutation=t end
                end
            end
        end
        local blob=(table.concat(textParts," ").." "..table.concat(nameParts," ")):lower()

        -- Mutação
        local function canonMut(src)
            local s=src:gsub("rainbow balloon"," ")
            for _,m in ipairs(MUT_ORDER) do
                if s:find(m:lower(),1,true) then return m end
            end
            return nil
        end
        if out.mutation and out.mutation~="" then
            out.mutation=canonMut(out.mutation:lower()) or out.mutation
        else
            out.mutation=canonMut(blob)
        end

        -- Traits
        local scan=blob
        local seen={}
        for _,tr in ipairs(TRAIT_ORDER) do
            local key=tr:lower()
            if scan:find(key,1,true) then
                scan=scan:gsub(esc(key)," ")
                local canonical = TRAIT_ALIAS[tr] or tr
                if not seen[canonical] and (not out.mutation or out.mutation:lower()~=key) then
                    seen[canonical]=true
                    out.traits[#out.traits+1]=canonical
                end
            end
        end
        return out
    end

    -- ── Obter brainrot vencedor ──────────────────────
    local function getBrainrot()
        local targetPos=findRivalPlot()
        if not targetPos then return {name="Unknown",value="N/A"} end
        local debris=workspace:FindFirstChild("Debris")
        if not debris then return {name="Unknown",value="N/A"} end
        local bestVal,bestSg
        for _,v in ipairs(debris:GetChildren()) do
            if v.Name~="FastOverheadTemplate" then continue end
            local sg=v:FindFirstChildOfClass("SurfaceGui")
            if not sg or not sg.Adornee then continue end
            if (sg.Adornee.Position-targetPos).Magnitude>50 then continue end
            local gen=sg:FindFirstChild("Generation",true)
            if gen and gen:IsA("TextLabel") then
                local val=parseNumber(gen.Text)
                if not bestVal or val>bestVal then bestVal=val; bestSg=sg end
            end
        end
        if not bestSg then return {name="Unknown",value="N/A"} end
        local info=analyzeSurfaceGui(bestSg)
        return {
            name=info.name or "Unknown",
            value=bestVal and formatShortNumber(bestVal) or "N/A",
            mutation=info.mutation,
            traits=info.traits,
            rarity=info.rarity,
        }
    end

    -- ── Montar e enviar embed ────────────────────────
    local function sendWebhook(br)
        if not HttpRequest then return end

        -- Emoji e cor da mutação
        local mutEmoji = getMutEmoji(br.mutation)
        local mutKey   = br.mutation and (TRAIT_ALIAS[br.mutation] or br.mutation) or nil
        local color    = (mutKey and MUT_COLOR[mutKey]) or MUT_COLOR[br.mutation] or 0x2B2D31

        -- Emojis dos traits concatenados
        local traitStr = "—"
        if br.traits and #br.traits>0 then
            local parts={}
            for _,tr in ipairs(br.traits) do parts[#parts+1]=getTraitEmoji(tr) end
            traitStr=table.concat(parts," ")
        end

        -- Brainrot: emoji de mutação + nome (sem campo separado de mutação)
        local brainrotVal = mutEmoji.." **"..tostring(br.name).."**"

        local fields = {
            { name="Brainrot:", value=brainrotVal,                    inline=true },
            { name="Value:", value="`"..tostring(br.value).."/s`", inline=true },
        }
        fields[#fields+1]={ name="Traits:",  value=tostring(traitStr),          inline=false }
        fields[#fields+1]={ name="Stealer:", value="`"..LP.DisplayName.."`", inline=false }

        local avatar=string.format(
            "https://www.roblox.com/headshot-thumbnail/image?userId=%d&width=420&height=420&format=png",
            LP.UserId
        )

        pcall(function()
            HttpRequest({
                Url=WEBHOOK_URL, Method="POST",
                Headers={["Content-Type"]="application/json"},
                Body=HttpService:JSONEncode({
                    username="V3NT DUELS",
                    embeds={{
                        title    ="🏆 V3NT DUELS WON 🏆",
                        color    =color,
                        thumbnail={ url=avatar },
                        fields   =fields,
                        footer   ={ text="V3NT DUELS  \226\128\162  "..os.date("%H:%M:%S") },
                        timestamp=os.date("!%Y-%m-%dT%H:%M:%SZ"),
                    }}
                })
            })
        end)
    end

