    local MUTATION_ALIAS = { ["Yin Yang"] = "YinYang" }

    -- Cores por mutação (para a embed)
    local MUT_COLOR = {
        ["Crystal"]=0x8EF6FF, ["Phantom"]=0x6A0DAD, ["Disco"]=0xFF1493,
        ["Cyber"]=0x00E5FF,   ["Rainbow"]=0xFF5FD2, ["Divine"]=0xFFF3B0,
